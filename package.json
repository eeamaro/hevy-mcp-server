{
  "name": "hevy-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Hevy workout tracking API with dual transport support (stdio + SSE)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:transport": "npm run build && node scripts/test-streamable-http.mjs",
    "watch": "tsc --watch",
    "generate-token": "tsx scripts/generate-token.ts"
  },
  "keywords": [
    "mcp",
    "hevy",
    "workout",
    "fitness",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/madebydia/hevy-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/madebydia/hevy-mcp-server/issues"
  },
  "homepage": "https://github.com/madebydia/hevy-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "8.6.0",
    "helmet": "8.1.0",
    "sanitize-html": "2.17.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.24",
    "@types/sanitize-html": "2.16.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "postcss": "8.5.23"
  }
}
